generator client {
  provider = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USER (lightweight reference - actual data in auth-service)
// ─────────────────────────────────────────────
model User {
  id    BigInt   @id

  serverMembers                   ServerMember[]
  channelMembers                  ChannelMember[]
  channelMessages                 ChannelMessage[]              @relation("ChannelMessageSender")
  conversationMembers             ConversationMember[]
  conversationMessages            ConversationMessage[]         @relation("ConversationMessageSender")
  messageReactions                MessageReaction[]
  channelMessageReadReceipts      ChannelMessageReadReceipt[]
  conversationMessageReadReceipts ConversationMessageReadReceipt[]
  conversationMessageReactions    ConversationMessageReaction[]
  userKey                         UserKey?
  posts                           Post[]                        @relation("PostAuthor")
  comments                        Comment[]                     @relation("CommentAuthor")
  ownedServers                    Server[]                      @relation("ServerOwner")
  postLikes                       PostLike[]


  @@map("users")
}

// ─────────────────────────────────────────────
// SERVER
// ─────────────────────────────────────────────
model Server {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy BigInt?
  owner     User?   @relation("ServerOwner", fields: [createdBy], references: [id])

  members  ServerMember[]
  channels Channel[]
  posts    Post[]
  roles    Role[]

  @@map("servers")
}

model Role {
  id                 BigInt   @id @default(autoincrement())
  name               String
  color              String?
  position           Int      @default(0)
  canManageServer    Boolean  @default(false)
  canManageChannels  Boolean  @default(false)
  canManageRoles     Boolean  @default(false)
  canKickMembers     Boolean  @default(false)
  canBanMembers      Boolean  @default(false)
  canSendMessages    Boolean  @default(true)
  canDeleteMessages  Boolean  @default(false)
  canMentionEveryone Boolean  @default(false)
  createdAt          DateTime @default(now())

  serverId BigInt
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  members ServerMember[]

  @@index([serverId])
  @@map("roles")
}

model ServerMember {
  id       BigInt   @id @default(autoincrement())
  nickname String?
  isBanned Boolean  @default(false)
  joinedAt DateTime @default(now())

  serverId BigInt
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId BigInt?
  role   Role?   @relation(fields: [roleId], references: [id])

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
  @@map("server_members")
}

// ─────────────────────────────────────────────
// CHANNEL
// ─────────────────────────────────────────────
model Channel {
  id          BigInt   @id @default(autoincrement())
  name        String
  description String?  @db.Text
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serverId BigInt
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  members  ChannelMember[]
  messages ChannelMessage[]

  @@unique([serverId, name])
  @@index([serverId])
  @@map("channels")
}

model ChannelMember {
  id        BigInt   @id @default(autoincrement())
  role      String   @default("member") // admin, moderator, member
  joinedAt  DateTime @default(now())

  channelId BigInt
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
  @@map("channel_members")
}

model ChannelMessage {
  id          BigInt   @id @default(autoincrement())
  content     String   @db.Text
  isEncrypted Boolean  @default(false)
  isEdited    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channelId BigInt
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  senderId BigInt
  sender   User   @relation("ChannelMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  reactions     MessageReaction[]
  readReceipts  ChannelMessageReadReceipt[]

  @@index([channelId])
  @@index([senderId])
  @@map("channel_messages")
}

model ChannelMessageReadReceipt {
  id     BigInt   @id @default(autoincrement())
  readAt DateTime @default(now())

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId BigInt
  message   ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@index([messageId])
  @@map("channel_message_read_receipts")
}

model MessageReaction {
  id     BigInt   @id @default(autoincrement())
  emoji  String
  addedAt DateTime @default(now())

  channelMessageId BigInt
  message          ChannelMessage @relation(fields: [channelMessageId], references: [id], onDelete: Cascade)

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelMessageId, emoji])
  @@index([channelMessageId])
  @@index([userId])
  @@map("message_reactions")
}

// ─────────────────────────────────────────────
// CONVERSATION (DMs)
// ─────────────────────────────────────────────
model Conversation {
  id      BigInt   @id @default(autoincrement())
  name    String?
  isGroup Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages ConversationMessage[]

  @@map("conversations")
}

model ConversationMember {
  id        BigInt   @id @default(autoincrement())
  joinedAt  DateTime @default(now())

  conversationId BigInt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_members")
}

model ConversationMessage {
  id          BigInt   @id @default(autoincrement())
  content     String   @db.Text
  isEncrypted Boolean  @default(false)
  isEdited    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversationId BigInt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId BigInt
  sender   User   @relation("ConversationMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  readReceipts ConversationMessageReadReceipt[]
  reactions    ConversationMessageReaction[]

  @@index([conversationId])
  @@index([senderId])
  @@map("conversation_messages")
}

model ConversationMessageReadReceipt {
  id     BigInt   @id @default(autoincrement())
  readAt DateTime @default(now())

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId BigInt
  message   ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@index([messageId])
  @@map("conversation_message_read_receipts")
}

model ConversationMessageReaction {
  id      BigInt   @id @default(autoincrement())
  emoji   String
  addedAt DateTime @default(now())

  conversationMessageId BigInt
  message               ConversationMessage @relation(fields: [conversationMessageId], references: [id], onDelete: Cascade)

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationMessageId, emoji])
  @@index([conversationMessageId])
  @@index([userId])
  @@map("conversation_message_reactions")
}

// ─────────────────────────────────────────────
// POSTS & COMMENTS (Server Feed)
// ─────────────────────────────────────────────
model Post {
  id        BigInt   @id @default(autoincrement())
  title     String?
  content   String   @db.Text
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serverId BigInt?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  authorId BigInt
  author   User   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  comments Comment[]
  likes    PostLike[]

  @@index([serverId])
  @@index([authorId])
  @@map("posts")
}

model PostLike {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model Comment {
  id        BigInt   @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId BigInt
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId BigInt
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

// ─────────────────────────────────────────────
// ENCRYPTION KEYS
// ─────────────────────────────────────────────
model UserKey {
  id        BigInt   @id @default(autoincrement())
  publicKey String   @db.Text
  createdAt DateTime @default(now())

  userId BigInt @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_keys")
}

// ─────────────────────────────────────────────
// PERMISSIONS
// ─────────────────────────────────────────────
model Permission {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@map("permissions")
}

