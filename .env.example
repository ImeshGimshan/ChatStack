# ============================================================
# ChatStack Environment Variables Template
# Copy this to .env and fill in your actual values
# ============================================================

JWT_SECRET=your-jwt-secret-at-least-256-bits-long

# ---- Auth DB (JDBC for Spring Boot) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://your-host/auth_db?sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# ---- Chat DB (Prisma / node-pg) ----
CHAT_DATABASE_URL=postgresql://user:password@host/chat_db?sslmode=require

# ---- Social DB (Prisma / node-pg) ----
SOCIAL_DATABASE_URL=postgresql://user:password@host/social_db?sslmode=require

# ---- MongoDB (Atlas) ----
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=YourApp

USER_SERVICE_PORT=5010
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:8080

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- FRONTEND (Public URLs) ---
NEXT_PUBLIC_AUTH_API=http://localhost:8080
NEXT_PUBLIC_CHAT_API=http://localhost:3333
NEXT_PUBLIC_MEDIA_API=http://localhost:3004

# ---- RabbitMQ (CloudAMQP) ----
RABBIT_MQ_URL=amqps://user:password@host/vhost
SPRING_RABBITMQ_HOST=your-rabbitmq-host
SPRING_RABBITMQ_PORT=5671
SPRING_RABBITMQ_USERNAME=your_username
SPRING_RABBITMQ_PASSWORD=your_password
SPRING_RABBITMQ_VIRTUAL_HOST=your_vhost
SPRING_RABBITMQ_SSL_ENABLED=true

# ---- Redis (Upstash) ----
REDIS_URL=rediss://default:your_token@your-host:6379

GMAIL_PASS=your_app_password
GMAIL_USER=your_email@gmail.com
